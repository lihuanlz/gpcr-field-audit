\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Per-study detail. \textbf  {a}, D2R cross-arm $\ensuremath  {p\!K_{\!A}}$ spread versus readout time; the calcium-influx arm sits $1.4$--$2.2\ensuremath  {\,\mathrm  {dex}}$ above cAMP. \textbf  {b}, D2R binding-versus-function fracture per ligand. \textbf  {c}, D2R arm separation growing with readout time; the bifeprunox bias factor versus ropinirole moves from $-0.42\ensuremath  {\,\mathrm  {dex}}$ (2~min) to $+1.93\ensuremath  {\,\mathrm  {dex}}$ (90~min). \textbf  {d}, AT1R arm-versus-arm separation across receptor backgrounds (significance annotated; lower bounds for TRV055 and AngII). \textbf  {e}, $\mu $OR identity-1 deviation heat map across assays and ligands; the GIRK column flags for all ligands. \textbf  {f}, $\mu $OR repair: estimated arm coordinates $\delta _{\mathrm  {arm}}$ under model M1, with the GIRK coordinate at $-0.805\ensuremath  {\,\mathrm  {dex}}$ and the whole-table improvement annotated.}}{9}{figure.caption.5}\protected@file@percent }
\newlabel{fig:maps}{{2}{9}{Per-study detail. \textbf {a}, D2R cross-arm $\pKA $ spread versus readout time; the calcium-influx arm sits $1.4$--$2.2\dex $ above cAMP. \textbf {b}, D2R binding-versus-function fracture per ligand. \textbf {c}, D2R arm separation growing with readout time; the bifeprunox bias factor versus ropinirole moves from $-0.42\dex $ (2~min) to $+1.93\dex $ (90~min). \textbf {d}, AT1R arm-versus-arm separation across receptor backgrounds (significance annotated; lower bounds for TRV055 and AngII). \textbf {e}, $\mu $OR identity-1 deviation heat map across assays and ligands; the GIRK column flags for all ligands. \textbf {f}, $\mu $OR repair: estimated arm coordinates $\delta _{\mathrm {arm}}$ under model M1, with the GIRK coordinate at $-0.805\dex $ and the whole-table improvement annotated}{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Atlas-wide distributions, robustness and repair. \textbf  {a}, Distribution of identity-1 deviations per entry (quantiles annotated). \textbf  {b}, Ranked per-paper median deviations for the 66 multi-ligand papers. \textbf  {c}, Constraint-projection repair cost across 269 groups (median $0.072\ensuremath  {\,\mathrm  {dex}}$; 24.2\% of groups above $0.3\ensuremath  {\,\mathrm  {dex}}$). \textbf  {d}, Repair cost versus mixture-model fracture probability (Spearman $0.962$; mixture parameters annotated). \textbf  {e}, Exceedance rates for groups and papers as the decision threshold is swept from $0.2$ to $1.0\ensuremath  {\,\mathrm  {dex}}$. \textbf  {f}, Robustness triple: negative control (haemoglobin), common-mode error calibration, most conservative aggregation, and column jackknife including the $\mu $OR GIRK column (retention $=1.0$).}}{10}{figure.caption.6}\protected@file@percent }
\newlabel{fig:atlas}{{3}{10}{Atlas-wide distributions, robustness and repair. \textbf {a}, Distribution of identity-1 deviations per entry (quantiles annotated). \textbf {b}, Ranked per-paper median deviations for the 66 multi-ligand papers. \textbf {c}, Constraint-projection repair cost across 269 groups (median $0.072\dex $; 24.2\% of groups above $0.3\dex $). \textbf {d}, Repair cost versus mixture-model fracture probability (Spearman $0.962$; mixture parameters annotated). \textbf {e}, Exceedance rates for groups and papers as the decision threshold is swept from $0.2$ to $1.0\dex $. \textbf {f}, Robustness triple: negative control (haemoglobin), common-mode error calibration, most conservative aggregation, and column jackknife including the $\mu $OR GIRK column (retention $=1.0$)}{figure.caption.6}{}}
