\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Anchor cases and Atlas-wide summary. \textbf  {a}, D2R binding-versus-function map: functional $\ensuremath  {p\!K_{\!A}}$ minus binding $\ensuremath  {p\!K_{i}}$ per ligand for the cAMP (circles) and G$\alpha $oB (squares) arms. The fracture is confined to the high-affinity partial agonists (orange), with bifeprunox at $-3.5\ensuremath  {\,\mathrm  {dex}}$ ($21$--$23\sigma $); ropinirole exceeds the resolvable range ($\tau \to \infty $). Orange arrowheads mark the positions carrying the study's significant-bias claims. \textbf  {b}, AT1R: G$_q$-arm (circle), $\beta $-arrestin-arm (square) and binding (diamond) affinities for TRV026 in wild-type and L112A receptors; the binding value sits between the two arm readings in both backgrounds. \textbf  {c}, $\mu $OR: per-ligand identity-1 deviations of the GIRK column (left; bars, significance in parentheses) and repair by one coordinate per arm (right; residuals before and after the M1 extension). \textbf  {d}, Atlas-wide identity-violation histogram of 17{,}987 ligand pairs (left; dashed lines at $0.3$ and $1\ensuremath  {\,\mathrm  {dex}}$) and ranked per-paper medians of the 66 multi-ligand papers (right; 15 above the $0.3\ensuremath  {\,\mathrm  {dex}}$ line).}}{6}{figure.caption.3}\protected@file@percent }
\newlabel{fig:anchors}{{1}{6}{Anchor cases and Atlas-wide summary. \textbf {a}, D2R binding-versus-function map: functional $\pKA $ minus binding $\pKi $ per ligand for the cAMP (circles) and G$\alpha $oB (squares) arms. The fracture is confined to the high-affinity partial agonists (orange), with bifeprunox at $-3.5\dex $ ($21$--$23\sigma $); ropinirole exceeds the resolvable range ($\tau \to \infty $). Orange arrowheads mark the positions carrying the study's significant-bias claims. \textbf {b}, AT1R: G$_q$-arm (circle), $\beta $-arrestin-arm (square) and binding (diamond) affinities for TRV026 in wild-type and L112A receptors; the binding value sits between the two arm readings in both backgrounds. \textbf {c}, $\mu $OR: per-ligand identity-1 deviations of the GIRK column (left; bars, significance in parentheses) and repair by one coordinate per arm (right; residuals before and after the M1 extension). \textbf {d}, Atlas-wide identity-violation histogram of 17{,}987 ligand pairs (left; dashed lines at $0.3$ and $1\dex $) and ranked per-paper medians of the 66 multi-ligand papers (right; 15 above the $0.3\dex $ line)}{figure.caption.3}{}}
